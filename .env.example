# JINZA Beat Store — environment template.
# Copy to .env (local dev only). NEVER commit real secrets.
# Production secrets live in Cloudflare: `wrangler secret put <NAME>`.

# --- App ---
APP_ENV=development            # development | staging | production
SITE_URL=http://localhost:8788 # public site URL (used in emails/redirects)

# --- Cloudflare bindings (set in wrangler.toml, not here) ---
# DB        -> D1 database  (jinza-db)
# PREVIEWS  -> R2 bucket    (jinza-previews, public)
# DELIVERY  -> R2 bucket    (jinza-delivery, private)

# --- Stripe (TEST keys only in dev; live keys only after owner approval) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- PayPal (SANDBOX only in dev; live only after owner approval) ---
PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_CLIENT_SECRET=sandbox_secret   # -> wrangler secret put in staging/prod
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Admin (local dev bootstrap only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=            # generate with the admin:create script, never plaintext

# --- Misc ---
DOWNLOAD_TOKEN_TTL_MINUTES=30
DOWNLOAD_MAX_USES=5
